{
  "name": "ngx-onboarding-app",
  "version": "1.18.0",
  "engines": {
    "node": "16.20.x || 18.x || 20.x || 22.x || 24.x"
  },
  "license": "MIT",
  "author": "ROSEN Group",
  "keywords": [
    "ngx-onboarding",
    "angular-onboarding",
    "onboarding"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "test": "ng test ngx-onboarding --watch=false --browsers=ChromeHeadless --code-coverage",
    "test-app": "ng test --watch=false --browsers=ChromeHeadless --code-coverage",
    "clean-dist": "rimraf dist",
    "build-lib": "ng build --configuration production ngx-onboarding && copyfiles *.md LICENSE.txt onboarding-demo.png dist/ngx-onboarding",
    "npm-pack": "cd dist/ngx-onboarding && npm pack",
    "package": "npm run clean-dist && npm run build-lib && npm run npm-pack",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^22.0.3",
    "@angular/cdk": "^22.0.2",
    "@angular/common": "^22.0.3",
    "@angular/compiler": "^22.0.3",
    "@angular/core": "^22.0.3",
    "@angular/forms": "^22.0.3",
    "@angular/material": "^22.0.2",
    "@angular/platform-browser": "^22.0.3",
    "@angular/platform-browser-dynamic": "^22.0.3",
    "@angular/router": "^22.0.3",
    "core-js": "^3.20.2",
    "reflect-metadata": "^0.1.12",
    "rxjs": "^6.5.3",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.0.4",
    "@angular/cli": "^22.0.4",
    "@angular/compiler-cli": "^22.0.3",
    "@angular/language-service": "^22.0.3",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^2.8.14",
    "@types/jasminewd2": "^2.0.6",
    "@types/node": "^12.11.1",
    "angular-eslint": "22.0.0",
    "copyfiles": "^2.1.0",
    "eslint": "^10.0.3",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~5.0.0",
    "karma": "^6.3.16",
    "karma-chrome-launcher": "~3.1.0",
    "karma-coverage-istanbul-reporter": "~3.0.2",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "karma-junit-reporter": "^2.0.1",
    "ng-packagr": "^22.0.0",
    "ts-node": "~5.0.1",
    "tslib": "^2.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-group/ngx-onboarding.git"
  }
}
