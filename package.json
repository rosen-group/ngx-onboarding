{
  "name": "ngx-onboarding-app",
  "version": "1.22.0",
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "license": "MIT",
  "author": "ROSEN Group",
  "keywords": [
    "ngx-onboarding",
    "angular-onboarding",
    "onboarding"
  ],
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build --configuration production",
    "test": "ng test ngx-onboarding --watch=false --coverage",
    "test-app": "ng test --watch=false --coverage",
    "clean-dist": "rimraf dist",
    "build-lib": "ng build --configuration production ngx-onboarding && copyfiles *.md LICENSE.txt onboarding-demo.png dist/ngx-onboarding",
    "npm-pack": "cd dist/ngx-onboarding && npm pack",
    "package": "npm run clean-dist && npm run build-lib && npm run npm-pack",
    "lint": "ng lint"
  },
  "dependencies": {
    "@angular/animations": "^22.2.3",
    "@angular/cdk": "^22.2.3",
    "@angular/common": "^22.2.3",
    "@angular/compiler": "^22.2.3",
    "@angular/core": "^22.2.3",
    "@angular/forms": "^22.2.3",
    "@angular/material": "^22.2.3",
    "@angular/platform-browser": "^22.2.3",
    "@angular/platform-browser-dynamic": "^22.2.3",
    "@angular/router": "^22.2.3",
    "core-js": "^3.20.2",
    "reflect-metadata": "^0.1.12",
    "rxjs": "^7.8.2",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^22.2.3",
    "@angular/cli": "^22.2.3",
    "@angular/compiler-cli": "^22.2.3",
    "@angular/language-service": "^22.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^4.1.11",
    "angular-eslint": "22.0.0",
    "copyfiles": "^2.1.0",
    "eslint": "^10.0.3",
    "jsdom": "^30.1.3",
    "ng-packagr": "^22.2.3",
    "rimraf": "^6.1.3",
    "tslib": "^2.3.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.62.0",
    "vitest": "^4.1.11"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rosen-group/ngx-onboarding.git"
  }
}
