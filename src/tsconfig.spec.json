{
    "extends": "../tsconfig.json",
    "compilerOptions": {
        "outDir": "../out-tsc/spec",
        "typeRoots": [
            "../node_modules/@types",
            "../node_modules"
        ],
        "types": [
            "vitest/globals",
            "node"
        ]
    },
    "files": [
        "polyfills.ts"
    ],
    "include": [
        "**/*.spec.ts",
        "**/*.d.ts",
        "test-setup.ts"
    ],
    "angularCompilerOptions": {
      "strictTemplates": false
    }
}
